DATABASE_URL="mysql://gold:YOUR_PASSWORD@127.0.0.1:3306/gold_pos"
PORT=4000
NODE_ENV=development
SESSION_SECRET="change-me-to-a-long-random-string"
SESSION_DAYS=7
APP_ORIGIN="http://localhost:5173"

# goldapi.dev — التوثيق: https://goldapi.dev/docs
# الخطة المجانية: 100 طلب في الساعة. التحديث كل 10 دقائق = 6 طلبات/ساعة فقط.
GOLD_PRICE_PROVIDER=manual
GOLD_PRICE_API_URL=https://goldapi.dev/api/v1
GOLD_PRICE_API_KEY=your-goldapi-key
# فاصل التحديث التلقائي لسعر الأونصة بالدقائق (0 = تعطيل التحديث التلقائي)
GOLD_PRICE_REFRESH_MINUTES=10

FX_PROVIDER=manual
FX_API_URL=
FX_API_KEY=
LOCAL_CURRENCY=LYD
